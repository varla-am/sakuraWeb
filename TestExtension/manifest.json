{
  "manifest_version": 3,
  "name": "Sakura Petals",
  "version": "1.0",
  "description": "Test extension for Sakura: paints any page pink.",
  "icons": { "48": "icon48.png", "128": "icon128.png" },
  "action": {
    "default_title": "Sakura Petals",
    "default_popup": "popup.html",
    "default_icon": { "32": "icon32.png", "48": "icon48.png" }
  },
  "background": { "service_worker": "background.js" },
  "permissions": ["activeTab", "scripting", "storage"]
}
